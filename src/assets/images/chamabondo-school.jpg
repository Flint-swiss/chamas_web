<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F4F7F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E8F2ED;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <rect x="50" y="100" width="700" height="400" rx="4" fill="#1E824C" opacity="0.1" stroke="#1E824C" stroke-width="2" stroke-dasharray="8,4"/>
  <g transform="translate(400,300)">
    <rect x="-60" y="-40" width="120" height="80" rx="2" fill="#0B2545" opacity="0.3"/>
    <rect x="-50" y="-30" width="30" height="25" rx="1" fill="#FFFFFF" opacity="0.5"/>
    <rect x="-10" y="-30" width="30" height="25" rx="1" fill="#FFFFFF" opacity="0.5"/>
    <rect x="-50" y="5" width="30" height="25" rx="1" fill="#FFFFFF" opacity="0.5"/>
    <rect x="-10" y="5" width="30" height="25" rx="1" fill="#FFFFFF" opacity="0.5"/>
  </g>
  <text x="400" y="520" font-family="Plus Jakarta Sans, Arial, sans-serif" font-size="20" font-weight="600" fill="#0B2545" text-anchor="middle">Chamabondo Primary School</text>
  <text x="400" y="545" font-family="Plus Jakarta Sans, Arial, sans-serif" font-size="14" fill="#566573" text-anchor="middle">Replace with actual school photograph</text>
